{
  "name": "sonoria",
  "version": "2.1.0",
  "description": "Audio analysis library for audio and music analysis, description and synthesis",
  "homepage": "https://github.com/FTS-TA/Sonoria/",
  "license": "AGPL-3.0-or-later",
  "supports": "!uwp",
  "dependencies": [
    "eigen3",
    "fftw3",
    "libav",
    "libsamplerate",
    "taglib",
    "yaml-cpp",
    "chromaprint"
  ],
  "features": {
    "gaia": {
      "description": "Build with Gaia2 support",
      "dependencies": [
        "gaia2"
      ]
    },
    "tensorflow": {
      "description": "Build with TensorFlow support",
      "dependencies": [
        "tensorflow"
      ]
    }
  }
}
