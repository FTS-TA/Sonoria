prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libsonoria
Description: audio analysis library -- development files
Version: @VERSION@
Requires.private: @REQUIRESPRIVATE@
Libs: -L${libdir} -lsonoria @LPATHS@ @LFLAGS@
Cflags: -I${includedir}/sonoria -I${includedir}/sonoria/scheduler -I${includedir}/sonoria/streaming -I${includedir}/sonoria/streaming/algorithms -I${includedir}/sonoria/utils
